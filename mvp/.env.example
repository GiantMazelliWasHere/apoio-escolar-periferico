# Copie para mvp/.env (o .env nunca vai para o git).
# Chave do OpenRouter: https://openrouter.ai/ — sem ela, a tela "Ajuda" mostra só as perguntas frequentes.
OPENROUTER_API_KEY=
# Opcional. Padrao: google/gemini-2.5-flash
GENAI_MODEL_NAME=
# URL pública do MVP, usada no QR code do suporte do Maker Lab (ex.: https://<app>.azurewebsites.net).
# Vazia: o QR usa o endereço pelo qual a página foi aberta (só para teste local).
PUBLIC_URL=
